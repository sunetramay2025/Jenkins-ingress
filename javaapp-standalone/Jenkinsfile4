pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-maven-docker
spec:
  containers:
  - name: maven
    image: maven:3.9.6-eclipse-temurin-21
    command: ["cat"]
    tty: true

  - name: docker
    image: docker:27.1.2
    command: ["cat"]
    tty: true

  serviceAccountName: jenkins
"""
        }
    }

    environment {
        GIT_URL     = "https://github.com/sunetramay2025/Jenkins-ingress.git"
        GIT_BRANCH  = "k8s-jenkins"
        IMAGE_REPO  = "655445510312.dkr.ecr.ap-south-1.amazonaws.com/jenkins/java"
        AWS_REGION  = "ap-south-1"
    }

    stages {

        stage("Checkout Repo") {
            steps {
                container("maven") {
                    sh """
                        git clone -b ${GIT_BRANCH} --single-branch ${GIT_URL} repo
                        echo "--- Repo structure ---"
                        ls -R repo
                    """
                }
            }
        }

        stage("Build JAR") {
            steps {
                container("maven") {
                    sh """
                        cd repo/javaapp-standalone
                        mvn clean package -DskipTests
                    """
                }
            }
        }

        stage("Build & Push Docker Image") {
            steps {
                container("docker") {
                    sh """
                        cd repo/javaapp-standalone

                        aws ecr get-login-password --region ${AWS_REGION} | \
                        docker login --username AWS --password-stdin ${IMAGE_REPO}

                        docker build -t javaapp:latest .
                        docker tag javaapp:latest ${IMAGE_REPO}:latest
                        docker push ${IMAGE_REPO}:latest
                    """
                }
            }
        }
    }
}
