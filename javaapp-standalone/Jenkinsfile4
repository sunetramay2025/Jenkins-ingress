pipeline {

    agent none

    environment {
        GIT_URL       = "https://github.com/sunetramay2025/Jenkins-ingress.git"
        GIT_BRANCH    = "k8s-jenkins"

        AWS_ACCOUNT   = "655445510312"
        AWS_REGION    = "ap-south-1"

        IMAGE_REPO    = "${AWS_ACCOUNT}.dkr.ecr.${AWS_REGION}.amazonaws.com/jenkins/cicd"
        IMAGE_TAG     = "${BUILD_NUMBER}"
        FULL_IMAGE    = "${IMAGE_REPO}:${IMAGE_TAG}"

        K8S_NAMESPACE = "javaapp"
        RELEASE_NAME  = "javaapp"
    }

    stages {

        stage("Build + Image + Deploy") {

            agent {
                kubernetes {
                    yaml """
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins-admin

  containers:

  - name: maven
    image: maven:3.9.6-eclipse-temurin-21
    command: ["sleep"]
    args: ["999999"]

  - name: kaniko
    image: gcr.io/kaniko-project/executor:v1.9.0-debug
    command: ["/busybox/sleep"]
    args: ["999999"]
    env:
    - name: DOCKER_CONFIG
      value: /kaniko/.docker
    volumeMounts:
    - name: docker-config
      mountPath: /kaniko/.docker/

  - name: helm
    image: alpine/helm:3.11.2
    command: ["sleep"]
    args: ["999999"]

  - name: jnlp
    image: jenkins/inbound-agent:latest

  volumes:
  - name: docker-config
    secret:
      secretName: regcred
      items:
        - key: .dockerconfigjson
          path: config.json
"""
                }
            }

            stages {

                stage("Checkout Repo") {
                    steps {
                        container("maven") {
                            sh """
                                git clone -b ${GIT_BRANCH} --single-branch ${GIT_URL} repo

                                ls -l repo
                            """
                        }
                    }
                }

                stage("Build JAR") {
                    steps {
                        container("maven") {
                            sh """
                                cd repo/javaapp-standalone
                                mvn -Dmaven.test.skip=true clean package
                                ls -l target
                            """
                        }
                    }
                }

                stage("Docker Build Using Kaniko") {
                    steps {
                        container("kaniko") {
                            sh """
                                echo "Logging in to ECR..."
                                aws ecr get-login-password --region ${AWS_REGION} \
                                  | docker login --username AWS --password-stdin ${AWS_ACCOUNT}.dkr.ecr.${AWS_REGION}.amazonaws.com

                                /kaniko/executor \
                                  --context=repo/javaapp-standalone \
                                  --dockerfile=repo/javaapp-standalone/Dockerfile \
                                  --destination=${FULL_IMAGE}
                            """
                        }
                    }
                }

                stage("Deploy to EKS Using Helm") {
                    steps {
                        container("helm") {
                            sh """
                                helm upgrade --install ${RELEASE_NAME} \
                                  repo/javaapp-standalone/chart/my-java-app \
                                  --namespace ${K8S_NAMESPACE} \
                                  --create-namespace \
                                  --set image.repository=${IMAGE_REPO} \
                                  --set image.tag=${IMAGE_TAG}
                            """
                        }
                    }
                }
            }
        }
    }
}
